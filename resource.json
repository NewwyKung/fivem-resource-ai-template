{
  "schemaVersion": 1,
  "name": "fivem-resource-ai-template",
  "type": "fivem-resource-template",
  "author": "Newwy",
  "version": "0.2.0",
  "framework": {
    "mode": "standalone",
    "optionalBridges": [
      "esx",
      "qbcore",
      "qbox"
    ]
  },
  "runtime": {
    "client": true,
    "server": true,
    "shared": true,
    "lua": "5.4"
  },
  "ui": {
    "enabled": true,
    "source": "resource/ui",
    "output": "resource/html",
    "framework": "svelte-5",
    "devPort": 5171
  },
  "database": {
    "required": false,
    "provider": null
  },
  "registries": {
    "index": ".ai/index.json",
    "features": ".ai/features",
    "components": ".ai/components",
    "events": ".ai/events",
    "database": ".ai/database",
    "integrations": ".ai/integrations/providers"
  },
  "memory": {
    "environment": ".ai/memory/environment.md",
    "activeRequirements": ".ai/memory/requirements/active",
    "deliveredRequirements": ".ai/memory/requirements/delivered",
    "supersededRequirements": ".ai/memory/requirements/superseded"
  },
  "architectureDecisions": [
    "docs/decisions/001-config-architecture.md",
    "docs/decisions/002-module-architecture.md",
    "docs/decisions/003-integration-architecture.md"
  ]
}
