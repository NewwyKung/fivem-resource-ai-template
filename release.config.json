{
  "schemaVersion": 2,
  "sourceDirectory": "resource",
  "outputDirectory": "release",
  "include": [
    "fxmanifest.lua",
    "README.md",
    "client",
    "server",
    "shared",
    "config",
    "html",
    "locales",
    "stream",
    "data",
    "sql"
  ],
  "exclude": [
    "**/.gitkeep",
    "**/*.example.lua",
    "**/*.example.json",
    "**/*.example.js",
    "**/*.map",
    "**/.DS_Store"
  ],
  "changeLog": {
    "enabled": false
  },
  "jsonSecretPaths": [],
  "textSanitizers": [],
  "secretKeyHints": [
    "webhook",
    "webhookUrl",
    "discordWebhook",
    "apiKey",
    "apiSecret",
    "clientSecret",
    "password",
    "privateKey"
  ],
  "secretValuePatterns": [
    "https://discord(?:app)?\\.com/api/webhooks/",
    "https://hooks\\.slack\\.com/",
    "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"
  ]
}
