{
  "$comment": "Copy to the resource repo root as .mcp-config.json. Every field is optional; scripts/mcp-server.ts auto-detects what it can from fxmanifest.lua and resource/ui when this file is absent or a field is omitted.",

  "resourceName": null,
  "resourcePath": "resource",

  "nui": {
    "enabled": false,
    "devUrl": "http://localhost:5173"
  },

  "runtimeTests": {
    "enabled": false
  },

  "database": {
    "driver": "none",
    "_comment_driver": "\"oxmysql\" enables live, read-only schema introspection (SHOW TABLES/DESCRIBE via the dev bridge) instead of the schemaFile fallback below.",
    "schemaFile": null,
    "_comment_schemaFile": "Used only when driver is not \"oxmysql\": path to a local .sql schema/migration file to read instead."
  }
}
